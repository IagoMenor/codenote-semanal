---
import '../../styles/global.css';

export async function getStaticPaths() {
  // Estos slugs deben ser EXACTAMENTE iguales a los que genera ProjectCard
  const proyectos = [
    { 
      slug: 'app-movil-de-gestion', 
      titulo: 'App Móvil de Gestión', 
      cuerpo: 'Este proyecto utiliza la REST API de WordPress para gestionar datos en tiempo real.' 
    },
    { 
      slug: 'rediseno-web-corporativa', // Asegúrate: sin tildes y con guiones
      titulo: 'Rediseño Web Corporativa', 
      cuerpo: 'Optimización de rendimiento utilizando componentes modernos de Astro.' 
    },
    { 
      slug: 'api-de-titulos-personalizada', 
      titulo: 'API de Títulos Personalizada', 
      cuerpo: 'Desarrollo de endpoints personalizados en PHP para filtrado de datos.' 
    }
  ];

  return proyectos.map((p) => ({
    params: { slug: p.slug },
    props: { p },
  }));
}

const { p } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{p.titulo}</title>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <nav class="p-6 bg-white shadow-md flex justify-center gap-6 mb-12">
        <a href="/" class="text-gray-600 hover:text-indigo-600">Inicio</a>
        <a href="/sobre-mi" class="text-gray-600 hover:text-indigo-600">Sobre mí</a>
        <a href="/proyectos" class="text-indigo-600 font-bold">Proyectos</a>
    </nav>

    <main class="max-w-3xl mx-auto px-6">
      <a href="/proyectos" class="text-indigo-600 hover:underline">← Volver</a>
      
      <div class="mt-8 bg-white p-10 rounded-3xl shadow-lg border border-gray-100">
        <h1 class="text-4xl font-extrabold mb-6">{p.titulo}</h1>
        <p class="text-xl text-gray-600 leading-relaxed italic border-l-4 border-indigo-500 pl-4">
          {p.cuerpo}
        </p>
      </div>
    </main>
  </body>
</html>