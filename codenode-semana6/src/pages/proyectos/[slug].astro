---
import '../../styles/global.css';

export async function getStaticPaths() {
  try {
    const response = await fetch('http://localhost/practicas-wordpress/wp-json/wp/v2/proyecto');
    const datosApi = await response.json();

    return datosApi.map((p) => ({
      params: { slug: p.slug },
      props: { proyecto: p }, // Pasamos el objeto entero como 'proyecto'
    }));
  } catch (e) {
    console.error("Error en API:", e);
    return [];
  }
}

const { proyecto } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title set:html={proyecto?.title?.rendered || 'Cargando...'} />
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <nav class="p-6 bg-white shadow-md flex justify-center gap-6 mb-12">
        <a href="/" class="text-gray-600 hover:text-indigo-600">Inicio</a>
        <a href="/sobre-mi" class="text-gray-600 hover:text-indigo-600">Sobre mí</a>
        <a href="/proyectos" class="text-indigo-600 font-bold">Proyectos</a>
    </nav>

    <main class="max-w-3xl mx-auto px-6 pb-20">
      <a href="/proyectos" class="text-indigo-600 hover:underline font-medium">← Volver al listado</a>
      
      {proyecto ? (
        <article class="mt-8 bg-white p-10 rounded-3xl shadow-xl border border-gray-100">
          <h1 class="text-4xl md:text-5xl font-extrabold mb-6 text-gray-900 leading-tight" 
              set:html={proyecto.title.rendered} />
          
          <div class="h-1 w-20 bg-indigo-500 mb-8 rounded-full"></div>

          <div class="prose prose-indigo max-w-none text-lg text-gray-700 leading-relaxed" 
               set:html={proyecto.content.rendered} />
        </article>
      ) : (
        <div class="mt-20 text-center">
            <p class="text-xl text-gray-500">No se ha podido cargar la información del proyecto.</p>
            <p class="text-sm text-gray-400 mt-2">Asegúrate de que XAMPP esté encendido.</p>
        </div>
      )}
    </main>
  </body>
</html>